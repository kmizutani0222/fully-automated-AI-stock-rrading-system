APP_ENV=development

# Host port 55432 is published by Docker Compose. Inside Compose the hostname is db and the port is 5432.
DATABASE_URL=postgresql+psycopg://asts:asts@localhost:55432/asts

TRADING_MODE=PAPER
LIVE_TRADING_ENABLED=false
TRADING_ENABLED=false

# yfinance, csv, or mock. mock is used only when selected here. A failed fetch does not insert synthetic prices.
MARKET_DATA_PROVIDER=yfinance

LOG_LEVEL=INFO
DEFAULT_TIMEFRAME=5m
CSV_TIMEZONE=UTC
